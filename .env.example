# Copy to .env and fill in for local (non-Docker) API runs:
#   uvicorn f1telemetry.api.main:app --reload

MONGO_URI=mongodb://localhost:27017
MONGO_DB=f1telemetry
MLFLOW_TRACKING_URI=file:./mlruns
# Run ID of the model to serve - pick the best config from the
# channel-ablation sweep (scripts/overnight_run.ps1) or an earlier training run.
MODEL_RUN_ID=
WINDOW_SIZE=20
STRIDE=10
TOP_FRACTION=0.05
